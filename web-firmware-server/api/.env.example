# ============================================================================
# WEB-FwServer API — Environment Variables
# Copy to .env (dev) or set in Railway dashboard for production
# ============================================================================

# Environment
NODE_ENV=development

# Port (Railway sets this automatically in production)
PORT=3002

# ============================================================================
# DATABASE — shared PostgreSQL instance with WEB-Marketplace
# ============================================================================
DATABASE_URL=postgres://user:password@localhost:5432/pds_marketplace

# Option 2: Individual variables
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pds
POSTGRES_PASSWORD=pds_dev_password
POSTGRES_DB=pds_marketplace

# ============================================================================
# SECURITY — must match WEB-Marketplace and WEB-HMI
# ============================================================================
JWT_SECRET=dev-secret-key-change-in-production

# ============================================================================
# CORS — comma-separated list of allowed origins
# ============================================================================
# In production: set to your domain. In dev: defaults to localhost:3001, 3000, 5173
# CORS_ORIGINS=https://pipedreamsystems.com

# ============================================================================
# FIRMWARE STORAGE
# ============================================================================
# Local path where firmware binary files are stored.
# In production: mount a Railway volume and point STORAGE_DIR at it.
# STORAGE_DIR=/data/firmware-storage
