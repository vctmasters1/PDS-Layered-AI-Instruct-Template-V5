# ============================================================================
# LOCAL DEVELOPMENT ENVIRONMENT
# Copy this to .env and adjust if needed
# ============================================================================

NODE_ENV=development

# Server
PORT=3000

# ============================================================================
# DATABASE (PostgreSQL via Docker)
# Run: npm run db:start  (or: docker compose up -d)
# ============================================================================
# Option 1: DATABASE_URL (takes precedence)
# DATABASE_URL=postgresql://pds:pds_dev_password@localhost:5432/pds_marketplace

# Option 2: Individual variables (defaults match docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pds
POSTGRES_PASSWORD=pds_dev_password
POSTGRES_DB=pds_marketplace

# ============================================================================
# JWT
# ============================================================================
JWT_SECRET=dev-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# ============================================================================
# CORS (local frontend)
# ============================================================================
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
STORE_URL=http://localhost:5173

# ============================================================================
# STRIPE (Test Keys — get from https://dashboard.stripe.com/test/apikeys)
# ============================================================================
STRIPE_PUBLIC_KEY=pk_test_REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ============================================================================
# TESTING MODE (Preview Phase)
# ============================================================================
TESTING_MODE=true
TEST_ACCESS_TOKEN=dev-test-token
