# ============================================================================
# PRODUCTION ENVIRONMENT VARIABLES
# Copy values from your deployment dashboard
# ============================================================================

# Environment
NODE_ENV=production

# Server Configuration
PORT=3000

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
# Option 1: Use DATABASE_URL (recommended)
DATABASE_URL=postgres://user:password@host:5432/pds_marketplace_prod

# Option 2: Use individual variables
POSTGRES_HOST=your-postgres-host.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-random-password-32-chars-minimum
POSTGRES_DB=pds_marketplace_prod

# ============================================================================
# SECURITY & JWT
# ============================================================================
# Generate a 32+ character random string for production
JWT_SECRET=generate-a-very-long-random-string-minimum-32-characters-here
JWT_EXPIRES_IN=24h

# ============================================================================
# CORS & DOMAIN CONFIGURATION
# ============================================================================
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com,https://admin.yourdomain.com
CORS_CREDENTIALS=true
STORE_URL=https://yourdomain.com
ADMIN_URL=https://admin.yourdomain.com

# ============================================================================
# TESTING/DEV ACCESS CONTROL (Preview Phase)
# ============================================================================
# When TESTING_MODE=true, only users with the TEST_ACCESS_TOKEN can access the site
# Set to false for production — all public users can access the site
TESTING_MODE=false
TEST_ACCESS_TOKEN=

# ============================================================================
# STRIPE PAYMENT (Live Keys for Production)
# ============================================================================
STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key_here
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# ============================================================================
# EMAIL SERVICE (SendGrid)
# ============================================================================
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=PDS Marketplace

# ============================================================================
# FILE STORAGE (AWS S3 or similar)
# ============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=pds-marketplace-prod-files
AWS_S3_URL=https://pds-marketplace-prod-files.s3.amazonaws.com

# ============================================================================
# CACHING & SESSIONS (Optional - Redis)
# ============================================================================
REDIS_URL=redis://your-redis-host:6379

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
LOG_LEVEL=info
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================================================
# APP METADATA
# ============================================================================
APP_NAME=PDS Marketplace
APP_VERSION=1.0.0

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_ANALYTICS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false
