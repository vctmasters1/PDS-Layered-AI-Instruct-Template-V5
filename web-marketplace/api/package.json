{
  "name": "pds-marketplace",
  "version": "1.0.0",
  "description": "PDS AutomationSuite - American Just-In-Time Marketplace",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run build && NODE_ENV=development node dist/index.js",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:migrate": "typeorm migration:run -d dist/database.js",
    "db:migrate:dev": "typeorm migration:run -d src/database.ts",
    "db:generate": "typeorm migration:generate -d src/database.ts",
    "db:revert": "typeorm migration:revert -d dist/database.js",
    "db:sync": "typeorm schema:sync -d src/database.ts",
    "seed:admin": "npm run build && node dist/scripts/seed-admin.js",
    "seed:dummy-profiles": "npm run build && node dist/scripts/seed-dummy-profiles.js",
    "seed:dummy-products": "npm run build && node dist/scripts/seed-dummy-products.js"
  },
  "keywords": [
    "api",
    "ecommerce",
    "marketplace",
    "just-in-time"
  ],
  "author": "PDS Team",
  "license": "MIT",
  "_moduleAliases": {
    "@db-central": "../../db-central/dist"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "bcrypt": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.3.4",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "pg": "^8.11.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "stripe": "^14.7.0",
    "typeorm": "^0.3.17",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.33",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}