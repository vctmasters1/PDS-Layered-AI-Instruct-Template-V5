# ─── HTTPS mode ────────────────────────────────────────────────────────────────
# CURRENT:  self-signed cert via Caddy's internal CA.
#           Browser shows a one-time security warning — click Advanced → Proceed.
#
# TO UPGRADE to a trusted cert (no browser warning):
#   Option A — DuckDNS / any domain, port 443 open:
#     Replace ":443" below with your domain, e.g. "resumesuite.duckdns.org"
#     Remove the "tls internal" line — Caddy handles Let's Encrypt automatically.
#
#   Option B — Cloudflare Tunnel (no open ports needed):
#     Run: cloudflared tunnel --config cloudflared.yml run
#     Point tunnel to http://app:38291 and remove this Caddyfile entirely.
# ────────────────────────────────────────────────────────────────────────────────

:443 {
	tls /certs/cert.pem /certs/key.pem
	reverse_proxy app:38291 {
		transport http {
			response_header_timeout 300s
			dial_timeout 10s
		}
		flush_interval -1
	}
}

:80 {
	redir https://{host}{uri} permanent
}
