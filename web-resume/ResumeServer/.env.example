# Resume-Suite Server — Environment Variables
# Enhanced for multi-mode deployment (local, lan, production, railway)
# Copy this file to .env and fill in real values.
# Never commit .env to git.

# ─── Deployment Mode ────────────────────────────────────────────────────────
# Options: local | lan | production | railway
# See .dev-docs/DEPLOYMENT-MODES.md for details
DEPLOY_MODE=local

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=38291
NODE_ENV=development

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Local dev (docker-compose.dev.yml default):
DATABASE_URL=postgresql://resumesuite:devpassword@localhost:5432/resumesuite
# Production (set by docker-compose.yml from POSTGRES_PASSWORD env):
# DATABASE_URL=postgresql://resumesuite:<password>@db:5432/resumesuite

# ─── Auth ────────────────────────────────────────────────────────────────────
# Must be at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_secret_here

# ─── LLM Studio ──────────────────────────────────────────────────────────────
LLM_API_URL=http://localhost:1234
LLM_MODEL=qwen/qwen3.6-35b-a3b
# Multi-GPU: run start-lms-instances.ps1 first, then set these:
# LLM_MODEL_IDS=qwen-0,qwen-1,qwen-2
# Timeout in milliseconds for LLM requests
LLM_TIMEOUT_MS=120000

# ─── File Storage ────────────────────────────────────────────────────────────
# Absolute path to the UserData directory.
# In Docker this is set to /app/userdata (mounted from ../UserData on the host).
# For local dev, leave blank to use the workspace's UserData/ directory.
USERDATA_PATH=

# ─── Python Runtime ──────────────────────────────────────────────────────────
# Command to invoke Python 3. In Docker this is "python3".
# On Windows this might be "python" or a full path.
PYTHON_CMD=python3

# ─── Network & TLS (Deployment Mode Specific) ───────────────────────────────
# LAN_IP: IP for LAN mode (e.g., 192.168.1.80)
LAN_IP=192.168.1.80

# LAN_HOSTNAME: Local hostname for LAN mode (e.g., resumesuite.local)
LAN_HOSTNAME=resumesuite.local

# DDNS_DOMAIN: Your DDNS domain for production mode
DDNS_DOMAIN=pds-resume-suite.mywire.org

# DYNU_TOKEN: API token for Dynu DDNS updates (production mode)
# Get from: https://www.dynu.com/ControlPanel/DynamicDNS/API
DYNU_TOKEN=

# POSTGRES_PASSWORD: Database password (production mode only)
POSTGRES_PASSWORD=

# ─── CORS & Access Control ──────────────────────────────────────────────────
# Additional origins beyond those automatically added for the current mode
ALLOWED_ORIGINS_EXTRA=

# ─── TLS Certificate Paths ──────────────────────────────────────────────────
TLS_CERT_PATH=./certs/cert.pem
TLS_KEY_PATH=./certs/key.pem
