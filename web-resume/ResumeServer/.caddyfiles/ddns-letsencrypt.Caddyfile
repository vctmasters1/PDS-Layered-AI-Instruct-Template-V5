# Caddyfile — PRODUCTION MODE (DDNS + Let's Encrypt)
# HTTPS with auto-renewing Let's Encrypt certificate
# Requires valid domain name and port 80/443 forwarding
# Used by: docker-compose.yml for production deployment
# Template variable: {DOMAIN} — replace with your DDNS domain

{DOMAIN} {
	# Caddy auto-acquires and renews Let's Encrypt cert
	# HTTP-01 challenge requires port 80 accessible from the internet
	reverse_proxy app:38291 {
		transport http {
			response_header_timeout 300s
			dial_timeout 10s
		}
		flush_interval -1
	}
}
