# Deployment mode configuration and defaults
# This file is sourced by start-dev.ps1 to set deployment mode

# Available modes:
# - local: Pure local development, HTTP only, localhost
# - lan: LAN + pseudo-production with self-signed TLS
# - production: Public internet with DDNS + Let's Encrypt
# - railway: Railway cloud deployment

# Set this to override the interactive prompt:
# DEPLOY_MODE=local

# ─── Local Development Mode ──────────────────────────────────────────────────
# Used for: npm run dev, local testing, no network access
# Vite dev server on :5173, Express on :38291, no TLS
# Set DEPLOY_MODE=local to use this

# ─── LAN / Pseudo-Production Mode ────────────────────────────────────────────
# Used for: Share with a few people on the same network or known public IPs
# Self-signed HTTPS on :443 (or :8443), no browser warning issue for trusting machines
# Set DEPLOY_MODE=lan to use this

# LAN_IP: IP address accessible within your network (e.g., 192.168.1.80)
LAN_IP=192.168.1.80

# LAN_HOSTNAME: Optional local hostname (e.g., resumesuite.local)
LAN_HOSTNAME=resumesuite.local

# ─── Production Mode (DDNS + Let's Encrypt) ─────────────────────────────────
# Used for: Public deployment with proper HTTPS
# Requires: Dynu DDNS domain, ports 80+443 forwarded, public internet access
# Set DEPLOY_MODE=production to use this

# DDNS_DOMAIN: Your Dynu DDNS domain or any domain (e.g., pds-resume-suite.mywire.org)
DDNS_DOMAIN=pds-resume-suite.mywire.org

# DDNS_UPDATE_INTERVAL_MIN: Minutes between IP updates (default 5)
DDNS_UPDATE_INTERVAL_MIN=5

# DYNU_TOKEN: Your Dynu API token for dynamic DNS updates
# Get this from: https://www.dynu.com/ControlPanel/DynamicDNS/API
# Do NOT commit this file with a real token! Use .env instead.
DYNU_TOKEN=<your-dynu-token-here>

# ─── Railway Mode ────────────────────────────────────────────────────────────
# Used for: Cloud deployment
# Set DEPLOY_MODE=railway to use this

# RAILWAY_SERVICE_DOMAIN: Your Railway service domain (auto-assigned by Railway)
RAILWAY_SERVICE_DOMAIN=

# ─── CORS & External Access ─────────────────────────────────────────────────
# Origins allowed to access the API (comma-separated)
# Automatically includes localhost, LAN IP, and DDNS domain based on mode
ALLOWED_ORIGINS_EXTRA=

# ─── TLS Certificate Paths ────────────────────────────────────────────────────
# For self-signed (LAN mode):
TLS_CERT_PATH=./certs/cert.pem
TLS_KEY_PATH=./certs/key.pem

# For Let's Encrypt (production mode):
# Caddy auto-manages certs in the caddy-data volume
