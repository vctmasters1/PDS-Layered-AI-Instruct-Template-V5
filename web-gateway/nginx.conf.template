events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # WebSocket upgrade support
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen 80;
        server_name _;

        # ── Health check ─────────────────────────────────────────────────────
        location = /health {
            return 200 'ok';
            add_header Content-Type text/plain;
        }

        # ── Root redirect ─────────────────────────────────────────────────────
        location = / {
            return 302 /marketplace/;
        }

        # ── HMI API ───────────────────────────────────────────────────────────
        # Strips /hmi/api/ prefix → hmi-service sees /v1/... requests
        location /hmi/api/ {
            proxy_pass          http://${HMI_HOST}:${HMI_PORT}/;
            proxy_http_version  1.1;
            proxy_set_header    Host              $host;
            proxy_set_header    X-Real-IP         $remote_addr;
            proxy_set_header    X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header    X-Forwarded-Proto $scheme;
            proxy_set_header    Upgrade           $http_upgrade;
            proxy_set_header    Connection        $connection_upgrade;
        }

        # ── HMI Frontend ──────────────────────────────────────────────────────
        # Strips /hmi/ prefix → hmi-service serves its static React bundle
        location /hmi/ {
            proxy_pass          http://${HMI_HOST}:${HMI_PORT}/;
            proxy_http_version  1.1;
            proxy_set_header    Host              $host;
            proxy_set_header    X-Real-IP         $remote_addr;
            proxy_set_header    X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header    X-Forwarded-Proto $scheme;
        }

        # ── Marketplace API ───────────────────────────────────────────────────
        # Strips /marketplace/api/ prefix → marketplace-service sees /v1/* and /socket.io/*
        location /marketplace/api/ {
            proxy_pass          http://${MKT_HOST}:${MKT_PORT}/;
            proxy_http_version  1.1;
            proxy_set_header    Host              $host;
            proxy_set_header    X-Real-IP         $remote_addr;
            proxy_set_header    X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header    X-Forwarded-Proto $scheme;
            proxy_set_header    Upgrade           $http_upgrade;
            proxy_set_header    Connection        $connection_upgrade;
            # Socket.IO long-poll requires longer timeouts
            proxy_read_timeout  86400s;
            proxy_send_timeout  86400s;
        }

        # ── Marketplace Frontend ──────────────────────────────────────────────
        # Strips /marketplace/ prefix → marketplace-service serves static assets
        location /marketplace/ {
            proxy_pass          http://${MKT_HOST}:${MKT_PORT}/;
            proxy_http_version  1.1;
            proxy_set_header    Host              $host;
            proxy_set_header    X-Real-IP         $remote_addr;
            proxy_set_header    X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header    X-Forwarded-Proto $scheme;
        }
        # ── Property Portal API ───────────────────────────────────────────────────
        # Strips /property/api/ prefix → property-service sees /v1/* requests
        location /property/api/ {
            proxy_pass          http://${PROP_HOST}:${PROP_PORT}/;
            proxy_http_version  1.1;
            proxy_set_header    Host              $host;
            proxy_set_header    X-Real-IP         $remote_addr;
            proxy_set_header    X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header    X-Forwarded-Proto $scheme;
        }

        # ── Property Portal Frontend ──────────────────────────────────────────────
        # Strips /property/ prefix → property-service serves its static React bundle
        location /property/ {
            proxy_pass          http://${PROP_HOST}:${PROP_PORT}/;
            proxy_http_version  1.1;
            proxy_set_header    Host              $host;
            proxy_set_header    X-Real-IP         $remote_addr;
            proxy_set_header    X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header    X-Forwarded-Proto $scheme;
        }

        # ── Resume Suite ─────────────────────────────────────────────────────────
        location /resume/ {
            proxy_pass          http://${RESUME_HOST}:${RESUME_PORT}/;
            proxy_http_version  1.1;
            proxy_set_header    Host              $host;
            proxy_set_header    X-Real-IP         $remote_addr;
            proxy_set_header    X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header    X-Forwarded-Proto $scheme;
            proxy_set_header    Upgrade           $http_upgrade;
            proxy_set_header    Connection        $connection_upgrade;
        }
    }
}
