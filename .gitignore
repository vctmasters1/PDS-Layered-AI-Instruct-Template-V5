# Environment & Credentials (NEVER COMMIT)
# Strategy: ignore real .env files everywhere; explicitly re-include *.example templates.
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# Dependencies
node_modules/
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.Python
pip-log.txt

# Build outputs
dist/
build/
out/
*.js.map
*.d.ts.map
.cache/
.next/
.nuxt/
.svelte-kit/

# IDE & editor
# Note: root-level <project>.code-workspace IS committed (shared workspace baseline).
# Ignore only the .vscode/ duplicates and personal local overrides.
.vscode/*.code-workspace
.vscode/*.local.json    # personal setting overrides — see .ai/conventions.md#gitignore-decisions
.idea/
*.suo
*.user
*.sublime-project
*.sublime-workspace

# OS artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Agentic runtime outputs (generated at runtime — never commit)
.ai/foresight/*
.ai/knowledge/*
.ai/logs/*
.ai/locks/*
.ai/agents/state/*
.ai/autonomous/queue.jsonl
.ai/autonomous/queue/*
!.ai/foresight/.gitkeep
!.ai/knowledge/.gitkeep
!.ai/knowledge/.cleanup-policy.md
!.ai/knowledge/phase2-learnings.md
!.ai/knowledge/cheat-sheets/
!.ai/logs/.gitkeep
!.ai/locks/.gitkeep

# Analysis & compliance reports (generated by import, validation tools)
.compliance-report.json
.lint-report.json
.ai/import-logs/
.ai/compliance-rules.yaml
!.ai/agents/state/.gitkeep

# Eval runtime output — schemas and examples are committed; run results are not
.ai/evals/results/*
!.ai/evals/results/.gitkeep

# Plugin runtime state — manifests and configs are committed; state/ is not
.ai/plugins/*/state/
# Adopter-edited tier table (the *.example.yaml is committed; the live copy isn't)
.ai/plugins/*/tiers.yaml
# Adopter-edited model loading strategy (the *.example.yaml is committed; the live copy isn't)
.ai/plugins/*/load_strategy.yaml
# Configuration snapshots (machine-specific; only active.txt metadata if any)
.ai/plugins/*/config/snapshots/
.ai/plugins/*/config/active.txt

# Test & coverage
coverage/
.nyc_output/
.pytest_cache/
htmlcov/
*.coverage

# Temporary & ephemeral
.github/tmp/*
!.github/tmp/README.md
.github/debug/*
!.github/debug/README.md
*.tmp
*.temp
*.swp
*~

# Database
*.sqlite
*.sqlite3
*.db

# Docker local overrides
docker-compose.override.yml

# Compiled binaries & firmware
*.bin
*.elf
*.hex
*.map
sdkconfig.old
