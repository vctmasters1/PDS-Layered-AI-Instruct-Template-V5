# HMI-WEB Environment Configuration

# Device Connection (Direct Local WiFi)
# Example: 192.168.1.100
VITE_DEVICE_IP=

# Device Port (default: 8443)
VITE_DEVICE_PORT=8443

# Device mDNS Hostname (optional)
# Example: h2o-tower.local
VITE_DEVICE_HOSTNAME=h2o-tower.local

# Device Connection Mode
# Options: 'direct' | 'internet' | 'auto'
# 'auto' = try direct first, then internet
VITE_CONNECTION_MODE=auto

# Internet Gateway URL (if device behind firewall)
# Example: https://api.pipedreamsystems.com/devices/h2o-001
VITE_GATEWAY_URL=

# Telemetry Polling Interval (milliseconds)
# Range: 500 - 5000
# Default: 1000 (1 second)
VITE_TELEMETRY_POLL_INTERVAL=1000

# Enable debug logging
VITE_DEBUG=false

# BLE Provisioning Proof of Possession
# Default: H2o12345 (change this in production!)
VITE_BLE_POP=H2o12345

# UI Theme
# Options: 'light' | 'dark' | 'auto'
VITE_THEME=auto

# Chart History Duration (minutes)
# How long to keep telemetry data for graphs
VITE_CHART_HISTORY_MINUTES=10

# API Timeout (milliseconds)
VITE_API_TIMEOUT=5000

# Enable certificate pinning (production only)
VITE_ENABLE_CERT_PINNING=false

# Device certificate fingerprint (if cert pinning enabled)
VITE_DEVICE_CERT_FINGERPRINT=

# Application Version (auto-set by build)
VITE_APP_VERSION=1.0.0

# Build timestamp (auto-set by build)
VITE_BUILD_TIME=
