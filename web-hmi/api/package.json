{
  "name": "web-hmi-api",
  "version": "1.0.0",
  "description": "PDS Devices Service — browser-based provisioning, configuration, and OTA firmware management",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run build && node dist/index.js",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "seed:dev": "npm run build && node dist/scripts/seed-dev.js",
    "dev:fresh": "npm run build && node dist/scripts/seed-dev.js && node dist/index.js",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "devices",
    "iot",
    "provisioning",
    "ota"
  ],
  "author": "PDS Team",
  "license": "MIT",
  "_moduleAliases": {
    "@db-central": "../../db-central/dist"
  },
  "dependencies": {
    "module-alias": "^2.2.3",
    "@pds/pipeline": "file:../../pds-pipeline",
    "bcrypt": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "qrcode": "^1.5.4",
    "typeorm": "^0.3.17",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.33",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.3",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0"
  }
}
