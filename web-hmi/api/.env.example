# ============================================================================
# WEB-HMI API — Environment Variables
# Copy to .env (dev) or .env.production (prod) and fill in values
# ============================================================================

# Environment
NODE_ENV=development

# Port (Railway sets this automatically in production)
PORT=3001

# ============================================================================
# DATABASE — shared PostgreSQL instance with WEB-Marketplace
# ============================================================================
# Option 1: Use DATABASE_URL (recommended for Railway)
DATABASE_URL=postgres://user:password@localhost:5432/pds_marketplace

# Option 2: Individual variables (used when DATABASE_URL is not set)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pds
POSTGRES_PASSWORD=pds_dev_password
POSTGRES_DB=pds_marketplace

# Optional: reject self-signed SSL certs (set to "true" only with proper certs)
DB_SSL_REJECT_UNAUTHORIZED=false

# ============================================================================
# SECURITY — must match WEB-Marketplace and WEB-FwServer
# ============================================================================
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-secret-key-change-in-production

# ============================================================================
# CORS
# ============================================================================
# Comma-separated list of allowed origins. Leave unset to allow all in dev.
# ALLOWED_ORIGINS=https://pipedreamsystems.com

# ============================================================================
# BASE URL (used in QR code generation)
# ============================================================================
BASE_URL=http://localhost:3001
