{
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/silabs",
    "${workspaceFolder}/common",
    "/opt/silabs/gecko_sdk/platform/common/inc",
    "/opt/silabs/gecko_sdk/platform/driver/inc",
    "/opt/silabs/gecko_sdk/app/common/util/app_log",
    "/opt/silabs/gecko_sdk/util/third_party/freertos/kernel/include"
  ],
  "C_Cpp.default.defines": [
    "SL_CATALOG_PERIPHERAL_SPI_PRESENT=1",
    "SL_CATALOG_PERIPHERAL_UART_PRESENT=1",
    "DEBUG=1"
  ],
  "C_Cpp.default.cppStandard": "c99",
  "C_Cpp.intelliSenseEngine": "Tag Parser",
  "C_Cpp.formatting": "Clang",
  "clangd.arguments": [
    "--header-insertion=never",
    "--clang-tidy=false",
    "-j=4"
  ],
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true,
    "editor.rulers": [80, 120]
  },
  "files.exclude": {
    "**/build": true,
    "**/.git": true,
    "**/node_modules": true
  },
  "cmake.configureOnOpen": true,
  "cmake.generator": "Ninja"
}
