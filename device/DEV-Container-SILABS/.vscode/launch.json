{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Silicon Labs JTAG Debug",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/output.elf",
      "args": [],
      "stopAtEntry": true,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/arm-none-eabi-gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Set ARM target",
          "text": "-target-select remote localhost:3333",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Build Project"
    },
    {
      "name": "Silicon Labs Serial Debug",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/output.elf",
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/arm-none-eabi-gdb"
    }
  ]
}
