{
  "name": "ESP-IDF Development",
  "dockerFile": "Dockerfile",
  "context": ".",
  "workspaceFolder": "/workspaces",
  "mounts": [
    "source=${localWorkspaceFolder}/../main,target=/src/main,type=bind,readonly",
    "source=${localWorkspaceFolder}/../pds,target=/src/pds,type=bind,readonly"
  ],
  "forwardPorts": [8443, 3333],
  "portsAttributes": {
    "8443": {
      "label": "HTTPS API",
      "onAutoForward": "notify"
    },
    "3333": {
      "label": "GDB Debug",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "espressif.esp-idf-extension",
        "espressif.esp-idf-web",
        "ms-vscode.cpptools",
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.makefile-tools"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "idf.espIdfPath": "/opt/esp/idf",
        "idf.toolsPath": "/opt/esp",
        "idf.gitPath": "/usr/bin/git",
        "idf.pythonPath": "/opt/esp/python_env/bin/python",
        "C_Cpp.default.includePath": [
          "${workspaceFolder}/pds/**",
          "${workspaceFolder}/main/**",
          "/opt/esp/idf/components/**"
        ],
        "C_Cpp.default.defines": [
          "ESP32C3",
          "CONFIG_IDF_TARGET_ESP32C3"
        ],
        "clangd.arguments": [
          "--header-insertion=never",
          "--clang-tidy=false",
          "-j=4"
        ],
        "cmake.configureOnOpen": true,
        "cmake.generator": "Ninja",
        "files.watcherExclude": {
          "**/build/**": true,
          "**/.git/**": true,
          "**/managed_components/**": true
        }
      }
    }
  },
  "remoteEnv": {
    "IDF_PATH": "/opt/esp/idf",
    "IDF_TOOLS_PATH": "/opt/esp",
    "IDF_PYTHON_ENV_PATH": "/opt/esp/python_env/idf5.4_py3.12_env",
    "PYTHONPATH": "/opt/esp/python_env/idf5.4_py3.12_env/lib/python3.12/site-packages:${PYTHONPATH}"
  },
  "remoteUser": "root",
  "runArgs": [
    "--privileged",
    "-e",
    "COLUMNS=200"
  ]
}
